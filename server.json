{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JonathanTECH1217/whitetape",
  "description": "US building permits as rows with the contractor of record. Free search; 7 cents a row, no account.",
  "version": "0.1.2",
  "websiteUrl": "https://whitetape.io",
  "repository": {
    "url": "https://github.com/JonathanTECH1217/whitetape",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "whitetape",
      "version": "0.1.2",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "--from",
          "valueHint": "--from"
        },
        {
          "type": "positional",
          "value": "whitetape[mcp]",
          "valueHint": "whitetape[mcp]"
        },
        {
          "type": "positional",
          "value": "whitetape-mcp",
          "valueHint": "whitetape-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "WHITETAPE_CREDIT",
          "description": "Optional. A prepaid link token from https://whitetape.io/credit/ so paid rows come off your balance; without it the ten free rows a month answer.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
